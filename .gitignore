__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# 编辑器与系统文件
.vscode/
.idea/
Thumbs.db
desktop.ini

# 临时的评审渲染产物
.review_render/

# GitHub 仓库的只读检出，不作为本仓库内容提交
.repo-review/

# 设计稿解析的中间产物
design/source/canvas.fig

# 微信开发者工具的个人配置与构建产物
project.private.config.json
miniprogram_npm/
node_modules/

# 临时的桌面截图目录（已弃用该调试方式）
.tmp_shot/

# 排查用的临时目录（注意：其中的 .wxss 会被开发者工具当作模块编译，不能留在工程内）
.tmp_*/

# 后端本地数据（数据库与录音文件）
backend/.data/

# pytest 临时目录（沙箱下系统临时目录不可写）
.pytest-tmp/
.pytest-run/
.pytest-runs/

# 数据库与端口文件（无论出现在哪个目录都不能入库）
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# 提交消息临时文件
commit-msg.tmp
