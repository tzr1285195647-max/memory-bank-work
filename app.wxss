/* 记忆银行小程序 · 全局设计 token
 * 数值全部来自 design/design-spec.json 的实测值（见 docs/DESIGN_SPEC.md）
 */

page {
  /* 色板 */
  --bg-page: #f6f2e9;
  --bg-card: #ffffff;
  --brand: #4e6657;
  --brand-light: #819276;
  --accent: #c98362;
  --text-primary: #26312b;
  --text-muted: #747a73;
  --surface-green: #e0e8d8;
  --surface-clay: #f6daca;
  --track: #e9e0cf;
  --danger-soft: #f5e0d6;
  --white: #ffffff;

  /* 圆角 */
  --radius-btn: 14px;
  --radius-card-sm: 18px;
  --radius-card: 20px;
  --radius-card-lg: 24px;
  --radius-card-xl: 28px;
  --radius-pill: 6px;

  /* 字体：SourceHanSerifSC 由 wx.loadFontFace 加载思源宋体子集，
     加载失败时按后面的顺序降级到系统宋体，版式不会崩 */
  --font-serif: "SourceHanSerifSC", "Noto Serif SC", "Songti SC", "STSong", "SimSun", serif;
  --font-latin: "Lora", Georgia, serif;

  /* 布局 */
  --page-padding: 24px;
  --nav-height: 92px;
  --tabbar-height: 76px;

  background-color: var(--bg-page);
  color: var(--text-primary);
  font-family: var(--font-serif);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 让所有页面自带底部安全区留白 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--bg-page);
}

.page.page--tab {
  /*
   * 用双类选择器锁定底部安全区，避免各页面稍后声明的 padding 简写
   * 把 padding-bottom 重置为 0。底栏本身约 76px，再留出 44px 可点击余量。
   */
  padding-bottom: calc(var(--tabbar-height) + 44px + env(safe-area-inset-bottom));
}

.container {
  padding: 0 var(--page-padding);
}

/* 文本层级：字号取自设计稿实际阶梯 */
.t-hero {
  font-size: 30px;
  font-weight: 700;
  line-height: 1.25;
  color: var(--text-primary);
}

.t-title {
  font-size: 25px;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text-primary);
}

.t-section {
  font-size: 20px;
  font-weight: 700;
  line-height: 1.4;
  color: var(--text-primary);
}

.t-card-title {
  font-size: 18px;
  font-weight: 700;
  line-height: 1.35;
  color: var(--text-primary);
}

.t-body {
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-muted);
}

.t-note {
  font-size: 15px;
  line-height: 1.5;
  color: var(--text-muted);
}

.t-caption {
  font-size: 13px;
  line-height: 1.4;
  color: var(--text-muted);
}

.t-brand {
  font-size: 24px;
  font-weight: 700;
  color: var(--white);
  font-family: var(--font-latin);
  letter-spacing: 0.5px;
}

/* 品牌色文字 */
.c-brand {
  color: var(--brand);
}
.c-accent {
  color: var(--accent);
}
.c-muted {
  color: var(--text-muted);
}

/* 通用间距 */
.mt-8 {
  margin-top: 8px;
}
.mt-12 {
  margin-top: 12px;
}
.mt-16 {
  margin-top: 16px;
}
.mt-24 {
  margin-top: 24px;
}
.mt-32 {
  margin-top: 32px;
}

.row {
  display: flex;
  align-items: center;
}

.row--between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hidden {
  display: none;
}
