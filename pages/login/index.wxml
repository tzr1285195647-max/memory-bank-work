<nav-bar title="记忆银行" theme="brand" showBack="{{true}}" showMore="{{false}}" />

<view class="page login" style="min-height: {{contentHeight}}px;">
  <view class="login__intro">
    <text class="t-hero">登录记忆银行</text>
    <text class="login__sub">登录后，继续保存珍贵的声音</text>
  </view>

  <view class="login__form">
    <text class="login__label">手机号</text>
    <input
      class="login__input"
      type="number"
      maxlength="11"
      placeholder="请输入手机号"
      placeholder-class="login__placeholder"
      value="{{phone}}"
      bindinput="onPhoneInput"
    />

    <text class="login__label login__label--second">{{loginMode === 'sms' ? '验证码' : '密码'}}</text>
    <input
      wx:if="{{loginMode === 'password'}}"
      class="login__input"
      password="{{true}}"
      maxlength="32"
      placeholder="请输入密码"
      placeholder-class="login__placeholder"
      value="{{password}}"
      bindinput="onPasswordInput"
    />
    <view wx:else class="login__code-row">
      <input class="login__input login__code-input" type="number" maxlength="6" placeholder="请输入 6 位验证码" value="{{smsCode}}" bindinput="onCodeInput" />
      <view class="login__code-send {{smsCountdown ? 'login__code-send--disabled' : ''}}" bindtap="onSendCode">{{smsCountdown ? smsCountdown + '秒' : '获取验证码'}}</view>
    </view>
    <text wx:if="{{errorText}}" class="login__error">{{errorText}}</text>
  </view>

  <view class="login__submit">
    <primary-button
      text="{{loginMode === 'sms' ? '验证码登录' : '登录'}}"
      type="primary"
      loading="{{submitting}}"
      loadingText="登录中"
      bind:tap="onLogin"
    />
  </view>

  <view class="login__links">
    <view class="login__link" bindtap="onSmsLogin">
      <text class="login__link-strong">{{loginMode === 'sms' ? '使用密码登录' : '验证码登录'}}</text>
    </view>
    <view class="login__link" bindtap="onRegister">
      <text class="login__link-normal">还没有账户？ 注册</text>
    </view>
  </view>

  <!-- 演示便利：一键填入演示账号（正式版应移除） -->
  <view class="login__demo" bindtap="onFillDemo">
    <text class="login__demo-title">演示账号</text>
    <text class="login__demo-text">{{demoPhone}} / {{demoPassword}}</text>
    <text class="login__demo-hint">点击自动填入 · 任意 11 位新手机号也可直接注册登录</text>
  </view>
</view>
