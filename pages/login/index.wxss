.login {
  padding: 0 24px;
  box-sizing: border-box;
}

.login__intro {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
}

.login__sub {
  margin-top: 12px;
  font-size: 16px;
  color: var(--text-muted);
}

/* 设计稿：手机号标签 y=329（标题块底约 275） */
.login__form {
  margin-top: 54px;
  display: flex;
  flex-direction: column;
}

.login__label {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-muted);
}

.login__label--second {
  margin-top: 40px;
}

.login__input {
  margin-top: 8px;
  height: 52px;
  border-radius: 14px;
  background-color: var(--bg-card);
  padding: 0 18px;
  box-sizing: border-box;
  font-size: 16px;
  color: var(--text-primary);
}

.login__placeholder {
  color: var(--text-muted);
}

/* 设计稿：按钮 y=545，密码框底 507 */
.login__submit {
  margin-top: 38px;
}

.login__links {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__link + .login__link {
  margin-top: 28px;
}

.login__link-strong {
  font-size: 15px;
  font-weight: 700;
  color: var(--brand);
}

.login__link-normal {
  font-size: 15px;
  color: var(--text-muted);
}

/* 演示账号提示块（正式版移除） */
.login__demo {
  margin-top: 40px;
  padding: 16px 18px;
  border-radius: 14px;
  background-color: var(--surface-green);
  display: flex;
  flex-direction: column;
}

.login__demo-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--brand);
}

.login__demo-text {
  margin-top: 6px;
  font-size: 17px;
  font-weight: 700;
  color: var(--text-primary);
  font-family: var(--font-latin);
}

.login__demo-hint {
  margin-top: 6px;
  font-size: 12px;
  color: var(--text-muted);
}
