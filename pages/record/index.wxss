.record {
  padding: 0 24px;
  box-sizing: border-box;
}

.record__intro {
  margin-top: 60px;
  display: flex;
  flex-direction: column;
}

.record__sub {
  margin-top: 14px;
  font-size: 15px;
  color: var(--text-muted);
}

.record__question {
  margin-top: 24px;
  padding: 18px 20px;
  border-radius: 18px;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

.record__question-label {
  font-size: 13px;
  font-weight: 700;
  color: var(--accent);
}

.record__question-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record__round {
  font-size: 12px;
  color: var(--text-muted);
}

.record__question-text {
  margin-top: 8px;
  font-size: 18px;
  line-height: 1.55;
  color: var(--text-primary);
}

/* 设计稿：342×250 圆角 28 浅绿，内容居中 */
.record__panel {
  margin-top: 28px;
  height: 250px;
  border-radius: 28px;
  background-color: var(--surface-green);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34px 0 0;
  box-sizing: border-box;
  position: relative;
}

.record__timer {
  font-size: 34px;
  font-weight: 700;
  color: var(--brand);
  font-family: var(--font-latin);
  letter-spacing: 1px;
}

.record__status {
  margin-top: 16px;
  display: flex;
  align-items: center;
}

.record__dot {
  font-size: 13px;
  color: var(--accent);
  margin-right: 6px;
}

.record__status-text {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent);
}

/* 设计稿：106×106 圆，圆心 y≈556，圆形底边压住面板底边 */
.record__button {
  position: absolute;
  /* 圆心保持在父容器内，避免部分 Android 真机不派发外溢区域的触摸事件。 */
  bottom: -32px;
  width: 106px;
  height: 106px;
  border-radius: 53px;
  background-color: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.record__button--hover {
  opacity: 0.88;
}

.record__button--disabled {
  opacity: 0.55;
}

.record__button-icon {
  font-size: 30px;
  font-weight: 700;
  color: var(--white);
  line-height: 1;
}

/* 设计稿：按钮 y=709 */
.record__actions {
  margin-top: 60px;
  display: flex;
  flex-direction: column;
}

.record__start-hint {
  margin-top: 10px;
  font-size: 12px;
  color: var(--text-muted);
}

.record__transcript {
  margin-top: 56px;
  padding: 18px 20px;
  border-radius: 18px;
  background-color: var(--bg-card);
  display: flex;
  flex-direction: column;
}

.record__transcript-label {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}

.record__transcript-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record__transcript-badge {
  padding: 4px 9px;
  border-radius: 10px;
  background-color: rgba(201, 131, 98, 0.14);
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
}

.record__transcript-badge--cloud {
  background-color: rgba(78, 102, 87, 0.12);
  color: var(--brand);
}

.record__transcript-hint {
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-muted);
}

.record__text-version { margin: 18rpx 0; padding: 18rpx; border-radius: 16rpx; background: #f3efe6; }
.record__text-version--agent { background: #edf2eb; }
.record__text-version-label { display: block; color: #4e6657; font-size: 24rpx; font-weight: 600; margin-bottom: 8rpx; }
.record__text-version-body { display: block; color: #747a73; font-size: 26rpx; line-height: 1.6; }
.record__uncertainty { display: block; color: #a45f43; font-size: 23rpx; }

.record__transcribe {
  margin-top: 14px;
  height: 42px;
  border-radius: 12px;
  background-color: var(--brand);
  color: var(--white);
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record__transcribe--disabled {
  opacity: 0.6;
}

.record__transcript-input {
  margin-top: 12px;
  width: 100%;
  height: 124px;
  padding: 12px;
  box-sizing: border-box;
  border-radius: 12px;
  background-color: #fbf9f3;
  font-size: 16px;
  line-height: 1.65;
  color: var(--text-primary);
}

.record__transcript-preview {
  margin-top: 12px;
  padding: 14px;
  border-radius: 12px;
  background-color: #fbf9f3;
  color: var(--text-primary);
  font-size: 16px;
  line-height: 1.65;
  word-break: break-all;
}

.record__transcript-tools {
  margin-top: 12px;
  display: flex;
  align-items: center;
}

.record__transcript-edit {
  width: 88px;
  height: 38px;
  flex: 0 0 88px;
  border: 1px solid rgba(78, 102, 87, 0.24);
  border-radius: 12px;
  color: var(--brand);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.record__transcript-confirm {
  height: 38px;
  flex: 1;
  border-radius: 12px;
  background-color: rgba(78, 102, 87, 0.12);
  color: var(--brand);
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record__transcript-edit + .record__transcript-confirm {
  margin-left: 8px;
}

.record__styles-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--text-primary);
}

.record__styles-hint {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--text-muted);
}

.record__style-list {
  margin-top: 14px;
  display: flex;
}

.record__style {
  flex: 1;
  min-width: 0;
  padding: 12px 8px;
  border: 1px solid rgba(78, 102, 87, 0.16);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fbf9f3;
}

.record__style + .record__style {
  margin-left: 8px;
}

.record__style--active {
  border-color: var(--brand);
  background-color: rgba(129, 146, 118, 0.14);
}

.record__style-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-primary);
}

.record__style-detail {
  margin-top: 5px;
  font-size: 10px;
  line-height: 1.35;
  text-align: center;
  color: var(--text-muted);
}

.record__actions > primary-button {
  margin-bottom: 16px;
}

.record__finish {
  margin-top: 0;
}

.record__finish-story {
  margin-top: 12px;
}

.record__transcript + .record__actions {
  margin-top: 18px;
}

.record__save-fragment {
  margin-top: 18px;
  padding: 18px;
  border: 1px solid rgba(78, 102, 87, 0.16);
  border-radius: 18px;
  background-color: var(--surface-green);
  display: flex;
  flex-direction: column;
}

.record__save-title {
  color: var(--brand);
  font-size: 17px;
  font-weight: 700;
}

.record__save-hint {
  margin-top: 6px;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.55;
}

.record__save-fragment > primary-button {
  margin-top: 14px;
}

.record__fragments {
  margin-top: 34px;
  padding: 22px 18px;
  border-radius: 22px;
  background: var(--bg-card);
  box-shadow: 0 7px 24px rgba(54, 66, 57, 0.06);
  display: flex;
  flex-direction: column;
}

.record__fragments-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.record__fragments-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--brand);
}

.record__fragments-count {
  padding: 4px 9px;
  border-radius: 11px;
  background: var(--surface-green);
  color: var(--brand);
  font-size: 11px;
  font-weight: 700;
}

.record__fragments-hint {
  margin-top: 7px;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.55;
}

.record__fragments-empty {
  margin-top: 16px;
  padding: 16px;
  border-radius: 14px;
  background-color: #fbf9f3;
  display: flex;
  flex-direction: column;
}

.record__fragments-empty-title {
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 700;
}

.record__fragments-empty-hint {
  margin-top: 5px;
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.5;
}

.record__fragment-list {
  margin-top: 18px;
  display: flex;
  flex-direction: column;
}

.record__fragment {
  padding: 16px 0;
  border-top: 1px solid rgba(78, 102, 87, 0.11);
  display: flex;
  align-items: flex-start;
}

.record__fragment-check {
  width: 26px;
  height: 26px;
  flex: 0 0 26px;
  border-radius: 13px;
  background: var(--surface-green);
  color: var(--brand);
  font-family: var(--font-latin);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(78, 102, 87, 0.28);
  box-sizing: border-box;
}

.record__fragment-check--selected {
  color: var(--white);
  background-color: var(--brand);
  border-color: var(--brand);
}

.record__fragment-main {
  margin-left: 12px;
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.record__fragment-origin {
  align-self: flex-start;
  margin-bottom: 8px;
  padding: 4px 9px;
  border-radius: 11px;
  background: var(--surface-clay);
  color: var(--accent);
  font-size: 11px;
  font-weight: 700;
}

.record__fragment-text {
  color: var(--text-primary);
  font-size: 15px;
  line-height: 1.75;
}

.record__fragment-time {
  color: var(--accent);
  font-size: 11px;
  text-align: right;
}
.record__fragment-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 10px; color: var(--brand); font-size: 12px; }
.record__fragment-delete { color: var(--accent); }
.record__fragment-pending { margin-left: 10px; color: var(--accent); }
.record__fragment-confirmed { margin-left: 10px; color: var(--brand); }
.record__fragment-confirm { font-weight: 700; }
.record__fragment-editor { margin-top: 10px; padding: 10px; border-radius: 12px; background: var(--bg-page); }
.record__fragment-editor-input { width: 100%; min-height: 90px; color: var(--text-primary); font-size: 14px; line-height: 1.7; }
.record__fragment-editor-actions { display: flex; justify-content: flex-end; gap: 20px; margin-top: 8px; color: var(--text-muted); font-size: 12px; }
.record__fragment-editor-save { color: var(--brand); font-weight: 700; }

.record__fragment-meta {
  margin-top: 8px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.record__generator {
  margin-top: 8px;
  padding: 18px 0 2px;
  border-top: 1px solid rgba(78, 102, 87, 0.11);
  display: flex;
  flex-direction: column;
}

.record__selection-bar {
  margin-top: 13px;
  padding: 10px 12px;
  border-radius: 12px;
  background-color: var(--surface-green);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record__selection-count {
  color: var(--brand);
  font-size: 12px;
  font-weight: 700;
}

.record__selection-all {
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
}

.record__generate-action {
  margin-top: 16px;
}

/* 未选主题时的空态 */
.record--empty .record__intro {
  margin-top: 60px;
}

.record__pick {
  margin-top: 48px;
}

.record__generating {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  padding: 0 28px;
  background-color: rgba(38, 49, 43, 0.48);
  display: flex;
  align-items: center;
  justify-content: center;
}

.record__generating-card {
  width: 100%;
  padding: 28px 24px;
  box-sizing: border-box;
  border-radius: 24px;
  background-color: var(--bg-page);
  display: flex;
  flex-direction: column;
}

.record__generating-title {
  font-size: 21px;
  font-weight: 700;
  color: var(--text-primary);
}

.record__generating-sub {
  margin-top: 7px;
  font-size: 13px;
  color: var(--text-muted);
}

.record__generation-list {
  margin-top: 24px;
}

.record__generation-step {
  display: flex;
  align-items: center;
  margin-top: 14px;
}

.record__generation-dot {
  width: 28px;
  height: 28px;
  border-radius: 14px;
  background-color: rgba(116, 122, 115, 0.14);
  color: var(--text-muted);
  font-size: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record__generation-dot--active {
  background-color: var(--accent);
  color: var(--white);
}

.record__generation-dot--done {
  background-color: var(--brand);
  color: var(--white);
}

.record__generation-text {
  margin-left: 12px;
  font-size: 15px;
  color: var(--text-muted);
}

.record__generation-text--active {
  color: var(--text-primary);
  font-weight: 700;
}
