<nav-bar title="记忆银行" theme="accent" showBack="{{true}}" showMore="{{false}}" />

<!-- tab 进入且未选主题时，先引导选题 -->
<view wx:if="{{!topicTitle}}" class="page page--tab record record--empty">
  <view class="record__intro">
    <text class="t-title">想讲哪一段？</text>
    <text class="record__sub">先选一个主题，再慢慢讲。</text>
  </view>
  <view class="record__pick">
    <primary-button text="去选主题" type="primary" bind:tap="onPickTopic" />
  </view>
</view>

<view wx:else class="page {{fromTab ? 'page--tab' : ''}} record">
  <view class="record__intro">
    <text class="t-title">慢慢讲，我在听</text>
    <text class="record__sub">不用准备稿，想到哪里说到哪里。</text>
  </view>

  <!-- 设计稿：342×250 浅绿区，圆角 28 -->
  <view class="record__panel">
    <text class="record__timer">{{timerText}}</text>
    <view class="record__status">
      <text class="record__dot">●</text>
      <text class="record__status-text">{{statusText}}</text>
    </view>
    <!-- 设计稿：106×106 圆形暂停键 -->
    <view class="record__button" hover-class="record__button--hover" bindtap="onToggle">
      <text class="record__button-icon">{{recording ? 'Ⅱ' : '▶'}}</text>
    </view>
  </view>

  <!-- 设计稿：独自讲述 / 双人访谈 -->
  <view class="record__modes">
    <text
      wx:for="{{modes}}"
      wx:key="id"
      class="record__mode {{mode === item.id ? 'record__mode--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="onModeChange"
    >{{item.label}}</text>
  </view>

  <view class="record__actions">
    <primary-button
      text="{{recording ? '暂停一下' : (seconds > 0 ? '继续讲述' : '开始讲述')}}"
      type="primary"
      bind:tap="onToggle"
    />
    <view wx:if="{{seconds > 0 && !recording}}" class="record__finish">
      <primary-button text="讲完了，生成故事" type="secondary" bind:tap="onFinish" />
    </view>
  </view>
</view>
