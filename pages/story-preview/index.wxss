.preview {
  padding: 0 24px;
  box-sizing: border-box;
}

.preview__intro {
  margin-top: 60px;
  display: flex;
  flex-direction: column;
}

.preview__sub {
  margin-top: 14px;
  font-size: 15px;
  color: var(--text-muted);
}

/* 设计稿：342×310 圆角 20 */
.preview__card {
  margin-top: 32px;
  border-radius: 20px;
  background-color: var(--bg-card);
  padding: 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.preview__title {
  font-size: 25px;
  font-weight: 700;
  color: var(--text-primary);
  font-family: var(--font-latin);
}

.preview__body {
  margin-top: 22px;
  font-size: 17px;
  line-height: 1.75;
  color: var(--text-muted);
  white-space: pre-wrap;
}

.preview__textarea {
  margin-top: 18px;
  width: 100%;
  min-height: 180px;
  font-size: 17px;
  line-height: 1.75;
  color: var(--text-primary);
  background-color: #fbf9f3;
  border-radius: 12px;
  padding: 12px;
  box-sizing: border-box;
}

/* 设计稿：来源标识 y=561，正文底约 481 */
.preview__meta {
  margin-top: 36px;
  display: flex;
  align-items: center;
}

.preview__playing {
  margin-left: 10px;
  font-size: 12px;
  color: var(--text-muted);
}

.preview__ai {
  margin-top: 10px;
  display: flex;
}

.preview__hint {
  margin-top: 28px;
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-muted);
  text-align: center;
}

.preview__actions {
  margin-top: 32px;
  padding-bottom: 40px;
  display: flex;
  flex-direction: column;
}

.preview__actions > primary-button {
  margin-bottom: 14px;
}

.preview__confirm {
  margin-top: 0;
}

/* 证据链：每条事实与它的原文来源 */
.preview__evidence {
  margin-top: 20px;
  padding: 18px 20px;
  border-radius: 18px;
  background-color: var(--bg-card);
}

.preview__evidence-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.preview__evidence-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
}

.preview__evidence-hint {
  font-size: 11px;
  color: var(--text-muted);
}

.preview__claim {
  margin-top: 14px;
  display: flex;
  align-items: flex-start;
}

.preview__claim-element {
  flex-shrink: 0;
  width: 44px;
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  padding-top: 2px;
}

.preview__claim-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.preview__claim-text {
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.5;
}

.preview__claim-quote {
  margin-top: 4px;
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.4;
}

/* 七要素完整度 */
.preview__missing {
  margin-top: 16px;
  padding: 16px 20px;
  border-radius: 18px;
  background-color: var(--surface-clay);
  display: flex;
  flex-direction: column;
}

.preview__missing-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-primary);
}

.preview__missing-tags {
  margin-top: 10px;
  display: flex;
  flex-wrap: wrap;
}

.preview__missing-tag {
  font-size: 12px;
  color: var(--accent);
  background-color: rgba(255, 255, 255, 0.7);
  border-radius: 8px;
  padding: 3px 10px;
  margin: 0 8px 8px 0;
}

.preview__missing-hint {
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.5;
}

/* 审计发现 */
.preview__findings {
  margin-top: 16px;
  padding: 16px 20px;
  border-radius: 18px;
  background-color: var(--danger-soft);
}

.preview__findings-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--accent);
}

.preview__finding {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
}

.preview__finding-text {
  font-size: 13px;
  color: var(--text-primary);
}

.preview__finding-excerpt {
  margin-top: 4px;
  font-size: 11px;
  color: var(--text-muted);
}
