<nav-bar title="家庭纪念册" theme="brand" showBack="{{true}}" showMore="{{false}}" />

<view class="page book">
  <view class="book__tabs">
    <view class="book__tab {{activeView === 'cover' ? 'book__tab--active' : ''}}" data-view="cover" bindtap="onView">封面</view>
    <view class="book__tab {{activeView === 'catalog' ? 'book__tab--active' : ''}}" data-view="catalog" bindtap="onView">目录</view>
    <view class="book__tab {{activeView === 'reading' ? 'book__tab--active' : ''}}" data-view="reading" bindtap="onView">阅读</view>
  </view>

  <view wx:if="{{activeView === 'cover'}}" class="book__cover">
    <view class="book__spine"></view>
    <text class="book__ornament">记 · 忆</text>
    <input wx:if="{{editingTitle}}" class="book__title-input" value="{{bookTitle}}" maxlength="20" focus="true" bindinput="onTitleInput" bindconfirm="onSaveTitle" />
    <text wx:else class="book__title" bindtap="onEditTitle">{{bookTitle}}</text>
    <text class="book__subtitle">一本由真实口述与家庭确认共同完成的故事书</text>
    <view class="book__rule"></view>
    <text class="book__range">{{yearRange}}</text>
    <view class="book__seal"><text>家藏</text></view>
    <text class="book__edit-hint">点击书名可以修改</text>
  </view>

  <view wx:if="{{activeView === 'cover'}}" class="book__stats">
    <view class="book__stat"><text class="book__stat-value">{{storyCount}}</text><text class="book__stat-label">篇故事</text></view>
    <view class="book__stat"><text class="book__stat-value">{{chapters.length}}</text><text class="book__stat-label">个年代</text></view>
    <view class="book__stat"><text class="book__stat-value">{{audioMinutes}}</text><text class="book__stat-label">分钟原声</text></view>
  </view>

  <view wx:if="{{activeView === 'catalog'}}" class="book__catalog">
    <text class="book__page-title">目录</text>
    <view wx:for="{{chapters}}" wx:key="key" class="book__chapter">
      <text class="book__chapter-year">{{item.yearLabel}}</text>
      <view wx:for="{{item.items}}" wx:for-item="story" wx:key="id" class="book__catalog-row" data-id="{{story.id}}" bindtap="onOpenStory"><text class="book__catalog-title">{{story.title}}</text><text class="book__catalog-stage">{{story.lifeStage}} ›</text></view>
    </view>
  </view>

  <view wx:if="{{activeView === 'reading'}}" class="book__reading">
    <view wx:for="{{chapters}}" wx:key="key" class="book__reading-chapter">
      <text class="book__reading-year">{{item.yearLabel}}</text>
      <view wx:for="{{item.items}}" wx:for-item="story" wx:key="id" class="book__story" data-id="{{story.id}}" bindtap="onOpenStory"><text class="book__story-stage">{{story.lifeStage}}</text><text class="book__story-title">{{story.title}}</text><text class="book__story-body">{{story.body}}</text><text class="book__story-source">原声 {{story.durationText}} · {{story.mode}} · 已确认</text></view>
    </view>
  </view>

  <view wx:if="{{!loading && !stories.length}}" class="book__empty"><text>先确认一个故事，再来制作纪念册。</text></view>
  <view class="book__actions"><primary-button text="复制纪念册文字" type="primary" bind:tap="onExportText" /><button class="book__share" open-type="share">分享纪念册入口</button></view>
</view>
