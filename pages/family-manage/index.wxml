<nav-bar title="家庭成员管理" theme="brand" showBack="{{true}}" showMore="{{false}}" />

<view class="page manage">
  <view class="manage__intro">
    <text class="t-title">{{familyName}}</text>
    <text class="manage__sub">四个账号共享故事、录音转写与记忆碎片。</text>
  </view>

  <view wx:if="{{isAdmin}}" class="manage__invite">
    <text class="manage__invite-kicker">管理员 · 通过手机号邀请</text>
    <input class="manage__input" type="number" maxlength="11" placeholder="输入成员手机号" value="{{invitePhone}}" bindinput="onInvitePhone" />
    <view class="manage__choice-row">
      <view class="manage__choice {{inviteRole === 'elder' ? 'manage__choice--active' : ''}}" data-role="elder" bindtap="onInviteRole">长辈</view>
      <view class="manage__choice {{inviteRole === 'family' ? 'manage__choice--active' : ''}}" data-role="family" bindtap="onInviteRole">晚辈家属</view>
    </view>
    <view class="manage__invite-action" bindtap="onInvite">{{inviting ? '正在邀请…' : '邀请加入家庭'}}</view>
    <text class="manage__invite-hint">已注册账号会立即加入；未注册手机号会保留邀请，注册后自动加入。</text>
  </view>

  <view wx:else class="manage__notice">只有家庭管理员小刘可以邀请、修改和移除成员。</view>

  <view class="manage__section-head">
    <text class="t-section">家庭成员</text>
    <text class="manage__count">{{members.length}} 人</text>
  </view>

  <view wx:if="{{loading}}" class="manage__empty">正在加载成员…</view>
  <view wx:for="{{members}}" wx:key="id" class="manage__member">
    <view class="manage__avatar manage__avatar--{{item.avatarKey}}">{{item.avatarText}}</view>
    <view class="manage__member-main">
      <view class="manage__member-head">
        <text class="manage__member-name">{{item.displayName}}</text>
        <text wx:if="{{item.isAdmin}}" class="manage__admin">管理员</text>
      </view>
      <text class="manage__member-meta">{{item.roleLabel}} · {{item.age}} 岁 · {{item.phoneMasked}}</text>
      <view wx:if="{{isAdmin}}" class="manage__member-actions">
        <text data-id="{{item.id}}" bindtap="onEditMember">编辑</text>
        <text wx:if="{{!item.isAdmin}}" class="manage__delete" data-id="{{item.id}}" bindtap="onDeleteMember">移除</text>
      </view>
    </view>
  </view>

  <view wx:if="{{editingId}}" class="manage__editor">
    <text class="t-section">编辑成员</text>
    <input class="manage__input" maxlength="20" value="{{editName}}" placeholder="昵称" bindinput="onEditName" />
    <input class="manage__input" type="number" maxlength="3" value="{{editAge}}" placeholder="年龄" bindinput="onEditAge" />
    <view class="manage__choice-row">
      <view class="manage__choice {{editGender === 'female' ? 'manage__choice--active' : ''}}" data-gender="female" bindtap="onEditGender">女</view>
      <view class="manage__choice {{editGender === 'male' ? 'manage__choice--active' : ''}}" data-gender="male" bindtap="onEditGender">男</view>
    </view>
    <view class="manage__choice-row">
      <view class="manage__choice {{editRole === 'elder' ? 'manage__choice--active' : ''}}" data-role="elder" bindtap="onEditRole">长辈</view>
      <view class="manage__choice {{editRole === 'family' ? 'manage__choice--active' : ''}}" data-role="family" bindtap="onEditRole">晚辈家属</view>
    </view>
    <view class="manage__editor-actions">
      <view class="manage__cancel" bindtap="onCancelEdit">取消</view>
      <view class="manage__save" bindtap="onSaveMember">{{saving ? '保存中…' : '保存修改'}}</view>
    </view>
  </view>

  <view wx:if="{{invitations.length}}" class="manage__pending">
    <text class="t-section">待注册邀请</text>
    <text wx:for="{{invitations}}" wx:key="id" class="manage__pending-item">{{item.phone}} · {{item.role === 'elder' ? '长辈' : '晚辈家属'}}</text>
  </view>
</view>
