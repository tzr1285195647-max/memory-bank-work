.manage { padding: 0 24px 48px; box-sizing: border-box; }
.manage__intro { margin-top: 52px; display: flex; flex-direction: column; }
.manage__sub { margin-top: 12px; color: var(--text-muted); font-size: 14px; line-height: 1.65; }
.manage__invite { margin-top: 26px; padding: 24px; border-radius: 22px; background: var(--surface-green); display: flex; flex-direction: column; align-items: center; text-align: center; }
.manage__invite-kicker { color: var(--brand); font-size: 11px; font-weight: 700; }
.manage__invite-code { margin-top: 13px; color: var(--text-primary); font-family: var(--font-latin); font-size: 34px; font-weight: 700; letter-spacing: 8px; }
.manage__invite-title { margin-top: 13px; color: var(--text-primary); font-size: 19px; font-weight: 700; }
.manage__invite-hint { margin-top: 10px; color: var(--text-muted); font-size: 12px; line-height: 1.55; }
.manage__invite-action { width: 170px; min-height: 42px; margin-top: 17px; border-radius: 12px; background: var(--brand); color: var(--white); font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.manage__family-hint { margin-top: 15px; color: var(--brand); font-size: 12px; }
.manage__section-head { margin-top: 34px; display: flex; align-items: baseline; justify-content: space-between; }
.manage__count { color: var(--text-muted); font-size: 12px; }
.manage__members { margin-top: 14px; border-radius: 18px; background: var(--bg-card); overflow: hidden; }
.manage__member { min-height: 76px; padding: 0 18px; border-bottom: 1px solid rgba(78, 102, 87, 0.1); display: flex; align-items: center; }
.manage__member:last-child { border-bottom: 0; }
.manage__avatar { width: 42px; height: 42px; flex-shrink: 0; border-radius: 21px; background: var(--brand-light); color: var(--white); font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.manage__member-main { flex: 1; min-width: 0; margin-left: 13px; display: flex; flex-direction: column; }
.manage__member-name { color: var(--text-primary); font-size: 15px; font-weight: 700; }
.manage__member-role { margin-top: 4px; color: var(--text-muted); font-size: 11px; }
.manage__member-status { color: var(--brand); font-size: 11px; }
.manage__section { margin-top: 34px; }
.manage__permissions { margin-top: 14px; }
.manage__permission { min-height: 76px; margin-bottom: 10px; padding: 15px 17px; box-sizing: border-box; border-radius: 16px; background: var(--bg-card); display: flex; align-items: flex-start; }
.manage__permission-role { flex-shrink: 0; padding: 4px 9px; border-radius: 11px; color: var(--white); font-size: 11px; font-weight: 700; }
.manage__permission-role--green { background: var(--brand); }
.manage__permission-role--clay { background: var(--accent); }
.manage__permission-detail { margin-left: 12px; color: var(--text-muted); font-size: 13px; line-height: 1.55; }
.manage__boundary { margin-top: 22px; padding: 18px; border-radius: 16px; background: var(--surface-clay); display: flex; flex-direction: column; }
.manage__boundary-title { color: var(--accent); font-size: 13px; font-weight: 700; }
.manage__boundary-text { margin-top: 7px; color: var(--text-muted); font-size: 12px; line-height: 1.6; }
.manage__switch { min-height: 46px; margin-top: 20px; color: var(--brand); font-size: 14px; display: flex; align-items: center; justify-content: center; }
