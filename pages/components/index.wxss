.demo {
  padding-bottom: 40px;
}

.demo__section {
  margin-top: 32px;
}

.demo__stack {
  margin-top: 12px;
  /* 让内嵌的 nav-bar（fixed）在预览里表现为普通块 */
  position: relative;
  border-radius: 12px;
  overflow: hidden;
}

.demo__stack--center {
  display: flex;
  justify-content: center;
}

.demo__row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
  flex-wrap: wrap;
}

.demo__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 12px;
}

.demo__swatch {
  width: 72px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.demo__swatch-color {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  border: 1px solid rgba(38, 49, 43, 0.08);
}

.demo__hex {
  font-size: 11px;
  color: var(--text-muted);
  margin-top: 2px;
}

.demo__ruler {
  width: 342px;
  max-width: 100%;
  height: 24px;
  margin-top: 12px;
  background-color: var(--surface-green);
  border-radius: 6px;
}
