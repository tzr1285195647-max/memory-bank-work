<nav-bar title="记忆银行" theme="brandLight" showBack="{{true}}" showMore="{{false}}" />

<view class="page topic">
  <view class="topic__head">
    <text class="t-title">今天，想讲哪一段？</text>
    <text class="topic__sub">选一个最容易想起的入口。</text>
  </view>

  <!-- 设计稿：四个 342×82 白卡，圆角 18，间距 23 -->
  <view class="topic__list">
    <list-item
      wx:for="{{topics}}"
      wx:key="id"
      variant="topic"
      glyph="{{item.glyph}}"
      title="{{item.title}}"
      subtitle="{{item.subtitle}}"
      arrow="→"
      data-id="{{item.id}}"
      bind:tap="onChoose"
    />
  </view>
</view>
