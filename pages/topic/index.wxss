.topic {
  padding: 0 24px;
  box-sizing: border-box;
}

/* 设计稿：标题 y=199（顶栏 92 下方约 107） */
.topic__head {
  margin-top: 60px;
  display: flex;
  flex-direction: column;
}

.topic__sub {
  margin-top: 14px;
  font-size: 15px;
  color: var(--text-muted);
}

/* 设计稿：首卡 y=319，标题块底约 272 */
.topic__list {
  margin-top: 46px;
  display: flex;
  flex-direction: column;
}

.topic__list > list-item {
  margin-bottom: 23px;
}

.topic__custom {
  margin: 8px 0 40px;
  padding: 20px;
  border-radius: 18px;
  background: #fff;
}

.topic__custom-label {
  display: block;
  margin-bottom: 12px;
  font-size: 18px;
  color: var(--text-primary);
}

.topic__custom-input {
  height: 48px;
  padding: 0 14px;
  border: 1px solid #d5ded4;
  border-radius: 12px;
  font-size: 16px;
}

.topic__custom-button {
  margin-top: 16px;
  background: #4b6255;
  color: #fff;
  border-radius: 12px;
  font-size: 16px;
}
