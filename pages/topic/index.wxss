.topic {
  padding: 0 24px;
  box-sizing: border-box;
}

/* 设计稿：标题 y=199（顶栏 92 下方约 107） */
.topic__head {
  margin-top: 60px;
  display: flex;
  flex-direction: column;
}

.topic__sub {
  margin-top: 14px;
  font-size: 15px;
  color: var(--text-muted);
}

/* 设计稿：首卡 y=319，标题块底约 272 */
.topic__list {
  margin-top: 46px;
  display: flex;
  flex-direction: column;
}

.topic__list > list-item {
  margin-bottom: 23px;
}
