.home {
  padding: 0 24px;
  box-sizing: border-box;
}

.home__intro {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
}

.home__sub {
  margin-top: 12px;
  font-size: 16px;
  color: var(--text-muted);
}

.home__cta {
  margin-top: 38px;
}

.home__section {
  margin-top: 44px;
}

/* 设计稿：342×104 白卡，圆角 18 */
.home__recent {
  margin-top: 16px;
}

.home__story {
  min-height: 122px;
  border-radius: 18px;
  background-color: var(--bg-card);
  padding: 20px 24px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.home__story--hover {
  background-color: #fbf9f3;
}

.home__story-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home__story-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home__story-meta {
  margin-top: 8px;
  font-size: 13px;
  color: var(--text-muted);
}

.home__story-excerpt {
  margin-top: 7px;
  max-width: 250px;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home__story-play {
  font-size: 30px;
  font-weight: 700;
  color: var(--accent);
  margin-left: 12px;
}

.home__empty {
  padding: 24px 0;
}
