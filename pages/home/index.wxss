.home {
  padding: 0 24px;
  box-sizing: border-box;
}

.home__intro {
  margin-top: 30px;
  display: flex;
  flex-direction: column;
}

.home__sub {
  margin-top: 12px;
  font-size: 16px;
  color: var(--text-muted);
}

/* 设计稿 y=325，浅陶土 342×148 圆角 24，内边距 24 */
.home__today {
  margin-top: 46px;
  height: 148px;
  border-radius: 24px;
  background-color: var(--surface-clay);
  padding: 24px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.home__today-label {
  font-size: 15px;
  font-weight: 700;
  color: var(--accent);
}

.home__today-title {
  margin-top: 13px;
  font-size: 28px;
  font-weight: 700;
  color: var(--text-primary);
}

.home__today-sub {
  margin-top: 6px;
  font-size: 14px;
  color: var(--text-muted);
}

/* 设计稿：按钮 y=507，卡片底 473 */
.home__cta {
  margin-top: 34px;
}

.home__section {
  margin-top: 48px;
}

/* 设计稿：342×104 白卡，圆角 18 */
.home__recent {
  margin-top: 16px;
}

.home__story {
  min-height: 104px;
  border-radius: 18px;
  background-color: var(--bg-card);
  padding: 20px 24px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.home__story--hover {
  background-color: #fbf9f3;
}

.home__story-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.home__story-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home__story-meta {
  margin-top: 11px;
  font-size: 13px;
  color: var(--text-muted);
}

.home__story-play {
  font-size: 22px;
  font-weight: 700;
  color: var(--accent);
  margin-left: 12px;
}
