<nav-bar title="记忆银行" theme="brand" showBack="{{true}}" showMore="{{false}}" />

<view class="page page--tab profile">
  <view class="profile__intro">
    <text class="t-title">我的账户</text>
    <text class="profile__sub">这些故事，属于你，也属于家人。</text>
  </view>

  <!-- 设计稿：342×108 白卡；头像 60 圆 -->
  <view class="profile__user">
    <view class="profile__avatar profile__avatar--{{profile.avatarKey}}">
      <text class="profile__avatar-text">{{profile.avatarText}}</text>
    </view>
    <view class="profile__user-main">
      <text class="profile__name">{{profile.displayName}}</text>
      <text class="profile__meta">{{profile.roleLabel}} · {{profile.phoneMasked}}</text>
    </view>
  </view>

  <text class="t-section profile__section">我的记录</text>

  <!-- 设计稿：三个 100×82 小卡，圆角 16 -->
  <view class="profile__stats">
    <view wx:for="{{statsList}}" wx:key="label" class="profile__stat">
      <text class="profile__stat-value">{{item.value}}</text>
      <text class="profile__stat-label">{{item.label}}</text>
    </view>
  </view>

  <text class="t-section profile__section">账户与家庭</text>

  <view class="profile__rows">
    <view class="profile__row" hover-class="profile__row--hover" bindtap="onEditNickname">
      <text class="profile__row-title">修改昵称</text>
      <text class="profile__row-arrow">›</text>
    </view>
    <view class="profile__row" hover-class="profile__row--hover" bindtap="onFamily">
      <text class="profile__row-title">家庭与协作</text>
      <text class="profile__row-arrow">›</text>
    </view>

    <view class="profile__row" hover-class="profile__row--hover" bindtap="onFamilyBoard">
      <text class="profile__row-title">家庭看板</text>
      <text class="profile__row-arrow">›</text>
    </view>

    <view class="profile__row" hover-class="profile__row--hover" bindtap="onPrivacyCenter">
      <text class="profile__row-title">隐私与操作记录</text>
      <text class="profile__row-arrow">›</text>
    </view>

  </view>

  <view class="profile__logout">
    <primary-button text="退出登录" type="danger" bind:tap="onLogout" />
  </view>
</view>
