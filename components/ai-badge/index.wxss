.ai-badge {
  display: inline-flex;
  align-items: center;
  padding: 0 8px;
  border-radius: 6px;
  background-color: rgba(201, 131, 98, 0.14);
  border: 1px solid rgba(201, 131, 98, 0.35);
}

.ai-badge__text {
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
  line-height: 20px;
}

.ai-badge--small {
  padding: 0 6px;
}

.ai-badge--small .ai-badge__text {
  font-size: 11px;
  line-height: 18px;
}
