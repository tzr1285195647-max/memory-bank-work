# 记忆银行后端环境变量
#
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，不会进入版本库。
# 用法（PowerShell）：Copy-Item .env.example .env，然后编辑 .env

# ---------- 智能体模式 ----------
# 首次离线安装可保持 mock；使用真实模型须改为 llm 并填写密钥。
AGENT_MODE=mock
# 只有 llm 模式才会调用下方模型地址。
LLM_API_KEY=
# 兼容 OpenAI 协议的任意服务：通义/智谱/月之暗面等都可用，只改这三项
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 单个 Agent 调用最坏耗时 = (1 + 重试次数) × LLM_TIMEOUT_SECONDS；小程序端超时按此上限设置，
# 调大重试次数前请同步检查 utils/api.js 的 AGENT_TIMEOUT / STORY_GENERATION_TIMEOUT。
LLM_MAX_RETRIES=1

# ---------- 腾讯云语音转文字（ASR）----------
# 只填写子用户创建的 API 密钥；真实值只能放在 .env，禁止提交到 Git。
# 密钥留空时不会调用腾讯云，现有本地录音和手动校对功能不受影响。
ASR_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh_en_2.0

# ---------- 运行参数 ----------
MEMORY_BANK_DATA_DIR=
HOST=127.0.0.1
# 手机真机调试时改为 HOST=0.0.0.0，并将 config.js 的 deviceBaseUrl 改为本机局域网 IPv4。
PORT=8787
# 生产必须换成随机值（演示版有默认值）
JWT_SECRET=
ALLOW_AUTO_REGISTER=0
ACCESS_TOKEN_MINUTES=720
MAX_UPLOAD_BYTES=104857600
