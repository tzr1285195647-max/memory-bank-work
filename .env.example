# 第一版默认使用无需密钥的 Mock 智能节点。
MEMORY_BANK_MODE=mock
MEMORY_BANK_DATA_DIR=.data
AUTH_REQUIRED=false

# 产品数据层（Docker Compose 默认值见 compose 文件）
DATABASE_URL=sqlite:///./.data/product.sqlite3
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-change-me-at-least-32-bytes
JWT_ISSUER=memory-bank
ACCESS_TOKEN_MINUTES=60
MAX_UPLOAD_BYTES=104857600

# 接入真实模型时再填写，并在 provider 适配层启用。
OPENAI_API_KEY=
